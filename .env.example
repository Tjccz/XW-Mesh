# =====================================================================
#  湘网组网 · 环境变量模板
#  用法：cp .env.example .env  然后按注释修改（.env 已被 .gitignore 排除）
# =====================================================================

# ---------- 控制台 ----------
# 控制台对外端口（宿主机）。宝塔放行这个端口，或用 Nginx 反向代理后改为 127.0.0.1:8080
# 可写 "8080"（对所有网卡开放）或 "127.0.0.1:8080"（只对本机开放，配合反代最安全）
HOST_PORT=8080

# 控制台对外访问地址（重要）
# 节点接入脚本、心跳回连都依赖它。用域名 + HTTPS 时务必写成 https:// 且有证书
# 例：https://mesh.example.com
CONSOLE_URL=

# 首次启动创建的管理员账号（数据库中已有用户时该项自动失效）
ADMIN_USER=admin
ADMIN_PASSWORD=xiangwang@2026

# ---------- 版本 ----------
# 控制台版本号（显示在页面与 /api/health）
XW_VERSION=1.1.0
# 节点侧组网核心版本（EasyTier release 版本号，不带 v）
ET_VERSION=2.6.4

# ---------- 系统 ----------
TZ=Asia/Shanghai

# =====================================================================
#  以下仅在需要「让服务器本身也作为节点组网」时填写
#  启用命令：docker compose --profile agent up -d
# =====================================================================

# 容器内回连控制台的地址。若控制台与本节点同机同编排，保持默认即可
AGENT_CONSOLE_URL=http://console:8080
# 节点核心 RPC 端口（容器内部端口，一般无需修改）
NODE_RPC_PORT=15888

# 二选一：
#  A. NODE_TOKEN —— 在控制台「设备管理」新增设备后，从接入命令中复制 token
#  B. ACCESS_KEY —— 在控制台「设备接入密钥」新建密钥后复制，容器首次启动自助注册
NODE_TOKEN=
ACCESS_KEY=
