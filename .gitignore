node_modules/

# ── 构建产物 ────────────────────────────────────────────────────────
# ⚠️ web/dist 刻意【纳入】版本管理。
#
# 理由：部署时 `git clone` 后要能直接 `docker build`，
#       NAS / 软路由上不必安装 Node、不必联网跑 Vite。
#       Dockerfile.slim 正是靠 `COPY web/dist` 复用这份预构建前端。
#
# 代价：前端改动后必须重新 `cd web && npm run build` 并提交 web/dist，
#       否则镜子里装的还是旧界面。
#
# 因此这里只忽略「根目录」的 dist —— 不要改成 `dist/`，
# 那会把 web/dist 一起忽略掉，构建将直接失败。
/dist/

# ── 运行数据与状态（绝不进仓库） ────────────────────────────────────
data/
node-state/
*.log

# ── 环境与密钥 ──────────────────────────────────────────────────────
.env
.env.local

# ── 编辑器 / 系统 ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
