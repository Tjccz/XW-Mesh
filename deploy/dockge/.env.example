# =====================================================================
#  湘网组网 · Dockge 部署环境变量
#  用法：复制为 .env 后修改（Dockge 界面里有 .env 编辑入口）
#        .env 已被 .gitignore 排除，不会进仓库
# =====================================================================

# ---------- 镜像 ----------
# 默认使用 GitHub 上已发布的镜像，**宿主机不需要做任何构建**。
#
# 若拉取报 401 / not found：说明该包的可见性还是 Private。
# 去 GitHub 头像 → Your packages → 选中该包 → Package settings
#   → Change visibility → Public
#
# 想改用本地自己构建的镜像，改成构建时的名字即可，例如：
#   CONSOLE_IMAGE=xiangwang-mesh-console:1.1.0
# 想始终跟随最新发布：把标签由 1.1.0 换成 latest
CONSOLE_IMAGE=ghcr.io/tjccz/xw-mesh-console:1.1.0

# ---------- 控制台 ----------
# 宿主机端口。默认 6088 —— 刻意避开 NAS / 软路由上常被占用的 8080。
# 若 6088 也被占用，换成其他空闲端口即可；容器内始终监听 8080，不用动。
HOST_PORT=6088

# 控制台对外访问地址 —— 留空即可
#
# 留空时程序会自动回退成「浏览器当前访问的地址」，
# 所以换机器、换端口、换 IP 都不用改这里，也不会出现
# 「设备接入脚本回连到旧地址」这类问题。
#
# 只有下列情况才需要显式填写：
#   · 用域名访问，例如 https://mesh.example.com
#   · 前面挂了反向代理
#   · 控制台的访问地址与设备能访问到的地址不一致（如 NAT 端口映射）
CONSOLE_URL=

# 首次启动创建的管理员账号（数据库里已有用户后此项自动失效）
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码

# ---------- 版本 ----------
XW_VERSION=1.1.0
# 节点侧组网核心版本（EasyTier release 版本号，不带 v）
ET_VERSION=2.6.4

# ---------- 系统 ----------
TZ=Asia/Shanghai

# =====================================================================
#  以下仅在部署 compose.full.yaml（让本机也作为节点）时需要
# =====================================================================

# 节点镜像地址；同样可用本地构建的镜像覆盖
NODE_IMAGE=ghcr.io/tjccz/xw-mesh-node:1.1.0

# 控制台「设备接入密钥」里新建密钥后复制过来，形如 ek_xxxxxxxx
ACCESS_KEY=
