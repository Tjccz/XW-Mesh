# =====================================================================
#  湘网组网 · Dockge 部署环境变量
#  用法：复制为 .env 后修改（Dockge 界面里有 .env 编辑入口）
#        .env 已被 .gitignore 排除，不会进仓库
# =====================================================================

# ---------- 控制台 ----------
# 宿主机端口。192.168.88.5 的 8080 已确认空闲；
# 若与其他服务冲突，改成 18080 等其他空闲端口即可
HOST_PORT=8080

# 控制台对外访问地址（重要）
# 节点接入脚本与设备心跳都靠它回连。这里填路由器在局域网里的地址；
# 以后加了域名/反代，改成 https://mesh.example.com
CONSOLE_URL=http://192.168.88.5:8080

# 首次启动创建的管理员账号（数据库里已有用户后此项自动失效）
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码

# ---------- 版本 ----------
XW_VERSION=1.1.0
# 节点侧组网核心版本（EasyTier release 版本号，不带 v）
ET_VERSION=2.6.4

# ---------- 系统 ----------
TZ=Asia/Shanghai

# =====================================================================
#  以下仅在部署 compose.full.yaml（让本机也作为节点）时需要
# =====================================================================

# 控制台「设备接入密钥」里新建密钥后复制过来，形如 ek_xxxxxxxx
ACCESS_KEY=
